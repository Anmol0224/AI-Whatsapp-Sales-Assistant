NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>.mongodb.net/
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_32_BYTES_OR_MORE
JWT_EXPIRES_IN=1h

# Optional Meta WhatsApp Cloud API settings; blank values keep integration inactive.
# Set an explicitly supported Graph API version when enabling WhatsApp integration.
META_GRAPH_API_VERSION=v26.0
# Set privately from Meta; never commit a real access token.
WHATSAPP_ACCESS_TOKEN=
# Generate a private random verification token (at least 32 characters).
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret: 32 hexadecimal characters. Keep private.
META_APP_SECRET=
